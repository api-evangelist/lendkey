            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.lendkey.com/esign/v1/leads/create",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a lead record in the Greenhouse LOS to capture information about potential customers and where their traffic was driven in from."
        }
      ]
    }
  ],
  "bundled": true
