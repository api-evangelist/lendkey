{
  "opencollection": "1.0.0",
  "info": {
    "name": "LendKey E-Sign API (via Kong Gateway) Application Contracts email API",
    "version": "0.1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "email",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Send An Email Notification",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.lendkey.com/esign/v1/notifications/emails",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Sends an email notification."
        },
        {
          "info": {
            "name": "Returns a list of ALL email templates available for use via notifier-api.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lendkey.com/esign/v1/notifications/emails/templates"
          },
          "docs": "Lists out ALL email templates known to this service, regardless of their provider (i.e. SendGrid)."
        }
      ]
    }
  ],
  "bundled": true
}